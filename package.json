{
  "name": "cup-signal-injective",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "World Cup matchday AI cockpit for Injective Global Cup, with x402 paywall demo, USDC CCTP checkout flow, MCP tools, and Agent Skill handoff.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test test/*.test.ts",
    "audit:pages": "tsx scripts/audit-pages-build.ts",
    "check:submission": "tsx scripts/check-submission.ts",
    "preview": "vite preview --host 127.0.0.1",
    "server:x402": "tsx server/x402-report-server.ts",
    "server:x402:live": "tsx server/x402-live-server.ts",
    "x402:quote:live": "tsx scripts/quote-live-x402.ts",
    "x402:pay:live": "tsx scripts/pay-live-x402.ts",
    "worker:types": "wrangler types worker-configuration.d.ts",
    "worker:deploy": "wrangler deploy --minify",
    "mcp": "tsx mcp/cup-signal-mcp.ts",
    "demo:agent": "tsx scripts/agent-demo.ts",
    "check:mcp": "tsx scripts/check-mcp.ts",
    "proof:judge": "tsx scripts/generate-judge-proof.ts",
    "contract:compile": "tsx scripts/compile-proof-contract.ts",
    "wallet:testnet:create": "tsx scripts/create-testnet-wallet.ts",
    "wallet:testnet:balance": "tsx scripts/check-testnet-balance.ts",
    "contract:deploy:testnet": "tsx scripts/deploy-proof-contract.ts",
    "contract:verify:testnet": "tsx scripts/verify-onchain-proof.ts",
    "wallet:x402:payer:create": "tsx scripts/create-x402-payer-wallet.ts",
    "x402:balances": "tsx scripts/check-x402-balances.ts",
    "capture": "tsx scripts/capture-demo.ts",
    "update:worldcup": "node --import tsx scripts/update-worldcup-data.mjs"
  },
  "dependencies": {
    "@injectivelabs/x402": "^0.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/express": "^4.17.25",
    "@vitejs/plugin-react": "^4.6.0",
    "@x402/core": "^2.20.0",
    "express": "^4.22.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "viem": "^2.55.11",
    "vite": "^7.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "playwright": "^1.61.1",
    "solc": "^0.8.36",
    "wrangler": "^4.118.0"
  },
  "engines": {
    "node": ">=20"
  }
}
